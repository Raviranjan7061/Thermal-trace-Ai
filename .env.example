# ThermalTrace AI — Environment Variables Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# NASA FIRMS API Integration
# Obtain your free MAP_KEY from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Database Configuration
# Production PostGIS format: postgresql://user:password@localhost:5432/thermaltrace_db
# Local development fallback: sqlite:///./thermaltrace.db
DATABASE_URL=sqlite:///./thermaltrace.db

# Ingestion Worker
SYNC_INTERVAL_MINUTES=30
AUTO_SYNC_ON_STARTUP=true
DEFAULT_COUNTRY_CODE=IND

# Authentication
JWT_SECRET=thermaltrace_super_secret_jwt_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Settings
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
